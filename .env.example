# KSP Crime Intelligence — environment template
# Copy to .env and fill values. Do not commit secrets.
# Full reference: CONFIGURATION.md

APP_ENV=development
LOG_LEVEL=debug

# Public web (safe to expose to browsers)
NEXT_PUBLIC_APP_NAME=KSP Crime Intelligence
NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
NEXT_PUBLIC_CATALYST_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_MAP_CENTER=15.3173,75.7139
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7
NEXT_PUBLIC_MAX_GRAPH_NODES=300
NEXT_PUBLIC_DEMO_WATERMARK=true

# API / analytics
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_DATE_RANGE_DAYS=366
CACHE_TTL_SECONDS_KPI=600
CACHE_TTL_SECONDS_ME=300
SPIKE_BASELINE_WEEKS=8
SPIKE_RATIO_THRESHOLD=1.75
GRAPH_MAX_HOPS=2
GRAPH_MAX_NODES=300
IMPORT_MAX_BYTES=52428800
FEATURE_RAG_ENABLED=false
SMARTBROWZ_ENABLED=true

# RBAC / role configuration (server-side only)
PII_ROLES=SUPER_ADMIN,SCRB_ANALYST,DISTRICT_COMMAND,SHO,IO
EXPORT_ROLES=SUPER_ADMIN,SCRB_ANALYST,DISTRICT_COMMAND
MFA_ENFORCED_ROLES=SUPER_ADMIN,SCRB_ANALYST
ALERT_NOTIFY_ROLES=SCRB_ANALYST,DISTRICT_COMMAND
MAIL_FROM=
MODEL_RISK_VERSION=risk-v1
